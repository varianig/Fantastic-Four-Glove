import board
import analogio
import usb_hid
from adafruit_hid.keyboard import Keyboard
from adafruit_hid.keycode import Keycode
import time

# Setup
flex_sensor_pointer = analogio.AnalogIn(board.GP26)
kbd = Keyboard(usb_hid.devices)

# Calibration
cal_vals = []
for cal in range(100):
    analog_reading = int(flex_sensor_pointer.value / 200)
    cal_vals.append(analog_reading)
    print("Flex sensor reading = ", analog_reading)
    print("cal:", cal)
    time.sleep(0.05)

cal_min = min(cal_vals)
cal_max = max(cal_vals)
print("min:", cal_min, "max:", cal_max)
time.sleep(5)

# Main loop
while True:
    analog_reading = int(flex_sensor_pointer.value / 200)
    print("Flex sensor reading = ", analog_reading)

    if analog_reading < cal_min:
        print("flexed backward")
        kbd.send(Keycode.CONTROL, Keycode.MINUS)   # Zoom out
    elif analog_reading > cal_max:
        print("flexed forward")
        kbd.send(Keycode.CONTROL, Keycode.EQUALS)  # Zoom in
    else:
        print("no flex")

    time.sleep(1)
